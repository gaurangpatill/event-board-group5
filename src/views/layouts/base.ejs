<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>EventBoard</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
      [x-cloak] { display: none !important; }
      input[type="search"]::-webkit-search-cancel-button { display: none; }
    </style>
    <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/collapse@3/dist/cdn.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3/dist/cdn.min.js"></script>
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
  </head>
  <body class="min-h-screen text-slate-900 p-6" style="background: linear-gradient(135deg, #f8f6ff 0%, #ffffff 50%, #f0f5ff 100%);">
    <div class="max-w-5xl mx-auto">
      <nav x-data="{ mobileMenuOpen: false }" class="mb-6 md:flex md:items-center md:justify-between md:gap-3">
        <div class="flex items-center justify-between gap-3">
        <a href="<%= session?.authenticatedUser ? '/events' : '/login' %>"
          class="inline-flex items-center gap-2.5 px-4 py-3 rounded-xl bg-white border-2 shadow-lg font-bold no-underline transition"
          style="border-color: #C897D8; color: #33315A;"
        >
          <span class="w-2.5 h-2.5 rounded-full" style="background: linear-gradient(135deg, #C897D8, #FC6A97);"></span>
          EventBoard
        </a>

        <button
          type="button"
          class="md:hidden inline-flex items-center justify-center w-11 h-11 rounded-lg bg-white border-2"
          style="border-color: #C897D8; color: #774C79;"
          @click="mobileMenuOpen = !mobileMenuOpen"
          :aria-expanded="mobileMenuOpen.toString()"
          aria-controls="mobile-menu"
          aria-label="Toggle navigation"
        >
          <svg x-show="!mobileMenuOpen" x-cloak xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg x-show="mobileMenuOpen" x-cloak xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
        </div>

        <div class="hidden md:flex items-center gap-3 flex-wrap">
          <% if (session?.authenticatedUser) { %>
            <a href="/events" class="font-semibold no-underline hover:underline" style="color: #3878E2;">Events</a>
            <% if (session.authenticatedUser.role === "user") { %>
            <a href="/dashboard/rsvps" class="font-semibold no-underline hover:underline" style="color: #3878E2;">RSVP Dashboard</a>
            <% } %>
            <% if (session.authenticatedUser.role === "admin") { %>
              <a href="/admin/users" class="font-semibold no-underline hover:underline" style="color: #3878E2;">Manage Users</a>
            <% } %>
            <% if (session.authenticatedUser.role === "staff" || session.authenticatedUser.role === "admin") { %>
              <a href="/dashboard/events" class="font-semibold no-underline hover:underline" style="color: #3878E2;">Organizer Dashboard</a>
            <% } %>
            <span class="text-slate-500">
              Signed in as <strong style="color: #33315A;"><%= session.authenticatedUser.displayName %></strong>
              (<%= session.authenticatedUser.role %>)
            </span>
            <form method="post" action="/logout" class="m-0">
              <button
                type="submit"
                class="px-3.5 py-2 rounded-lg bg-white border-2 cursor-pointer text-sm font-medium transition hover:opacity-80"
                style="border-color: #C897D8; color: #774C79;"
              >
                Log out
              </button>
            </form>
          <% } else { %>
            <a href="/login" class="font-semibold no-underline hover:underline" style="color: #3878E2;">Log in</a>
          <% } %>
        </div>

        <div
          id="mobile-menu"
          class="md:hidden mt-3"
          x-show="mobileMenuOpen"
          x-collapse
          x-cloak
        >
          <div class="flex flex-col gap-3 rounded-xl border-2 bg-white p-4" style="border-color: #C897D8;">
            <% if (session?.authenticatedUser) { %>
              <a href="/events" class="font-semibold no-underline" style="color: #3878E2;">Events</a>
              <% if (session.authenticatedUser.role === "user") { %>
              <a href="/dashboard/rsvps" class="font-semibold no-underline" style="color: #3878E2;">RSVP Dashboard</a>
              <% } %>
              <% if (session.authenticatedUser.role === "admin") { %>
                <a href="/admin/users" class="font-semibold no-underline" style="color: #3878E2;">Manage Users</a>
              <% } %>
              <% if (session.authenticatedUser.role === "staff" || session.authenticatedUser.role === "admin") { %>
                <a href="/dashboard/events" class="font-semibold no-underline" style="color: #3878E2;">Organizer Dashboard</a>
              <% } %>
              <span class="text-slate-500 text-sm">
                Signed in as <strong style="color: #33315A;"><%= session.authenticatedUser.displayName %></strong>
                (<%= session.authenticatedUser.role %>)
              </span>
              <form method="post" action="/logout" class="m-0">
                <button
                  type="submit"
                  class="px-3.5 py-2 rounded-lg bg-white border-2 cursor-pointer text-sm font-medium transition hover:opacity-80"
                  style="border-color: #C897D8; color: #774C79;"
                >
                  Log out
                </button>
              </form>
            <% } else { %>
              <a href="/login" class="font-semibold no-underline" style="color: #3878E2;">Log in</a>
            <% } %>
          </div>
        </div>
      </nav>
      <main class="max-w-5xl mx-auto"><%- body %></main>
    </div>
  </body>
</html>