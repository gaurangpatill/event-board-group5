<section class="max-w-3xl mx-auto">
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-slate-900 mb-2">Create Event</h1>
    <p class="text-slate-500">
      Add a new event with the key details organizers need to publish later.
    </p>
  </div>

  <% if (pageError) { %>
    <div class="mb-6">
      <%- include("../partials/error", { message: pageError }) %>
    </div>
  <% } %>

  <%- include("../partials/event-create-form", { values }) %>
</section>
