<% if (pageError && !event) { %>
  <div class="mb-5 p-4 border border-red-200 rounded-xl bg-red-50 text-red-700">
    <p class="font-medium"><%= pageError %></p>
  </div>
<% } %>

<% if (event) { %>

  <div class="relative rounded-2xl overflow-hidden mb-6 bg-gradient-to-br
    <%= event.status === 'published' ? 'from-blue-600 to-blue-800' :
        event.status === 'draft'     ? 'from-yellow-500 to-amber-600' :
        event.status === 'cancelled' ? 'from-slate-500 to-slate-700' :
                                       'from-slate-400 to-slate-600' %>
    shadow-xl p-8 text-white">



    <h1 class="text-3xl sm:text-4xl font-bold leading-tight mb-2"><%= event.title %></h1>

    <span class="inline-block px-2.5 py-0.5 rounded-full bg-white/15 text-white/90 text-xs font-medium">
      <%= event.category.charAt(0).toUpperCase() + event.category.slice(1) %>
    </span>

    <p class="mt-3 text-white/70 text-sm">Organized by <span class="text-white font-medium"><%= event.organizerName %></span></p>
  </div>

  <% if (pageError) { %>
    <div class="mb-5 p-4 border border-red-200 rounded-xl bg-red-50 text-red-700 text-sm">
      <p class="font-medium"><%= pageError %></p>
    </div>
  <% } %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <%# ── Left column: main content ───────────────────────────────────── %>
    <div class="lg:col-span-2 space-y-5">

      <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
        <h2 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-3">Description</h2>
        <p class="text-slate-700 leading-relaxed whitespace-pre-line"><%= event.description %></p>
      </section>

      <%# Date & time card - Alpine.js labels %>
      <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
        <h2 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-4">Date &amp; Time</h2>

        <div class="flex items-start gap-4 mb-4"
          x-data="relativeTime('<%= new Date(event.startDateTime).toISOString() %>')"
          x-init="init()">
          <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center text-blue-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-0.5">Starts</p>
            <p class="text-slate-800 font-medium"><%= new Date(event.startDateTime).toLocaleString() %></p>
            <p class="text-blue-600 text-sm font-medium mt-0.5" x-text="label" x-show="label"></p>
          </div>
        </div>

        <div class="flex items-start gap-4"
          x-data="relativeTime('<%= new Date(event.endDateTime).toISOString() %>')"
          x-init="init()">
          <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-slate-50 flex items-center justify-center text-slate-500">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-0.5">Ends</p>
            <p class="text-slate-800 font-medium"><%= new Date(event.endDateTime).toLocaleString() %></p>
            <p class="text-slate-500 text-sm mt-0.5" x-text="label" x-show="label"></p>
          </div>
        </div>
      </section>

      <%# Location %>
      <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
        <h2 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-4">Location</h2>
        <div class="flex items-center gap-3">
          <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-green-50 flex items-center justify-center text-green-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <p class="text-slate-800 font-medium"><%= event.location %></p>
        </div>
      </section>

    </div>

    <%# -- Right column: sidebar -- %>
    <div class="space-y-5">

      <%# Attendance card %>
      <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
        <h2 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-4">Attendance</h2>

        <% if (event.maxCapacity !== null) { %>
          <div class="flex items-end justify-between mb-2">
            <span class="text-3xl font-bold text-slate-900"><%= event.attendeeCount %></span>
            <span class="text-slate-400 text-sm mb-1">of <%= event.maxCapacity %> attending</span>
          </div>
         
          
        <% } else { %>
          <div class="flex items-center gap-2">
            <span class="text-3xl font-bold text-slate-900"><%= event.attendeeCount %></span>
            <span class="text-slate-400 text-sm">attending</span>
          </div>
          <p class="text-xs text-slate-500 mt-1">Unlimited capacity</p>
        <% } %>
      </section>

      <%# Organizer actions card — staff/admin only %>
      <% const isOrganizerOrAdmin = session.authenticatedUser &&
           (session.authenticatedUser.role === "admin" ||
            (session.authenticatedUser.role === "staff" &&
             session.authenticatedUser.userId === event.organizerId)); %>

      <% if (isOrganizerOrAdmin) { %>
        <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
          <h2 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-4">Manage Event</h2>
          <div class="space-y-2" id="event-actions">
            <% if (event.status === "draft") { %>
              <form method="POST" action="/events/<%= event.id %>/publish" class="m-0"
                hx-post="/events/<%= event.id %>/publish"
                hx-target="#event-actions"
                hx-swap="outerHTML">
                <button type="submit"
                  class="w-full px-4 py-2.5 rounded-xl bg-green-600 text-white font-semibold cursor-pointer hover:bg-green-700 text-sm transition-colors">
                  Publish Event
                </button>
              </form>
              <a href="/events/<%= event.id %>/edit"
                class="block w-full px-4 py-2.5 rounded-xl border border-slate-200 text-slate-700 font-semibold text-sm text-center no-underline hover:bg-slate-50 transition-colors">
                Edit Event
              </a>
            <% } %>
            <% if (event.status === "published") { %>
              <form method="POST" action="/events/<%= event.id %>/cancel" class="m-0"
                hx-post="/events/<%= event.id %>/cancel"
                hx-target="#event-actions"
                hx-swap="outerHTML">
                <button type="submit"
                  class="w-full px-4 py-2.5 rounded-xl bg-red-600 text-white font-semibold cursor-pointer hover:bg-red-700 text-sm transition-colors">
                  Cancel Event
                </button>
              </form>
              <a href="/events/<%= event.id %>/edit"
                class="block w-full px-4 py-2.5 rounded-xl border border-slate-200 text-slate-700 font-semibold text-sm text-center no-underline hover:bg-slate-50 transition-colors">
                Edit Event
              </a>
            <% } %>
            <% if (event.status === "cancelled" || event.status === "past") { %>
              <p class="text-sm text-slate-400 text-center py-2">No actions available</p>
            <% } %>
          </div>
        </section>
      <% } %>

      <%# RSVP section — members only %>
      <% if (session.authenticatedUser && session.authenticatedUser.role === "user") { %>
        <div
          id="rsvp-section"
          hx-get="/events/<%= event.id %>/rsvp-status"
          hx-trigger="load"
          hx-swap="outerHTML"
          class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 animate-pulse">
          <div class="h-4 bg-slate-100 rounded w-1/2 mb-3"></div>
          <div class="h-10 bg-slate-100 rounded-xl"></div>
        </div>
      <% } %>

    </div>
  </div>

<% } %>

<script>
  function relativeTime(isoString) {
    return {
      label: '',
      init() {
        const target = new Date(isoString);
        const now = new Date();
        const diffMs = target - now;
        const diffSec = Math.round(diffMs / 1000);
        const diffMin = Math.round(diffSec / 60);
        const diffHr  = Math.round(diffMin / 60);
        const diffDay = Math.round(diffHr / 24);

        if (diffMs < 0) {
          const absDays = Math.round(Math.abs(diffMs) / 86400000);
          if (absDays === 0) this.label = 'earlier today';
          else if (absDays === 1) this.label = 'yesterday';
          else this.label = absDays + ' days ago';
          return;
        }

        if (diffMin < 1)        this.label = 'in less than a minute';
        else if (diffMin < 60)  this.label = 'in ' + diffMin + ' minute' + (diffMin === 1 ? '' : 's');
        else if (diffHr < 24)   this.label = 'in ' + diffHr + ' hour' + (diffHr === 1 ? '' : 's');
        else if (diffDay === 1) this.label = 'tomorrow';
        else if (diffDay < 7)   this.label = 'in ' + diffDay + ' days';
        else if (diffDay < 14)  this.label = 'next week';
        else if (diffDay < 31)  this.label = 'in ' + Math.round(diffDay / 7) + ' weeks';
        else if (diffDay < 365) this.label = 'in ' + Math.round(diffDay / 30) + ' month' + (Math.round(diffDay/30) === 1 ? '' : 's');
        else                    this.label = 'in ' + Math.round(diffDay / 365) + ' year' + (Math.round(diffDay/365) === 1 ? '' : 's');
      }
    }
  }
</script>
