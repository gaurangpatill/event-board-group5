<% if (pageError && !event) { %>
  <div class="mb-5 p-4 border border-red-200 rounded-xl bg-red-50 text-red-700">
    <p class="font-medium"><%= pageError %></p>
  </div>
<% } %>

<% if (event) { %>
  <section class="mb-5 p-6 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-lg">

    <div class="flex items-start justify-between gap-4 mb-4 flex-wrap">
      <div>
        <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold mb-2
          <%= event.status === 'published' ? 'bg-green-100 text-green-700' :
              event.status === 'draft'     ? 'bg-yellow-100 text-yellow-700' :
              event.status === 'cancelled' ? 'bg-red-100 text-red-700' :
                                             'bg-slate-100 text-slate-500' %>">
          <%= event.status.charAt(0).toUpperCase() + event.status.slice(1) %>
        </span>
        <h1 class="text-3xl font-bold text-slate-900"><%= event.title %></h1>
      </div>

      <% const isOrganizerOrAdmin = session.authenticatedUser &&
           (session.authenticatedUser.role === "admin" ||
            (session.authenticatedUser.role === "staff" &&
             session.authenticatedUser.userId === event.organizerId)); %>

      <% if (isOrganizerOrAdmin) { %>
        <div class="flex gap-2 flex-wrap">
          <% if (event.status === "draft") { %>
            <form method="POST" action="/events/<%= event.id %>/publish" class="m-0">
              <button type="submit"
                class="px-4 py-2 rounded-lg bg-green-600 text-white font-medium cursor-pointer hover:bg-green-700 text-sm">
                Publish
              </button>
            </form>
          <% } %>
          <% if (event.status === "published") { %>
            <form method="POST" action="/events/<%= event.id %>/cancel" class="m-0">
              <button type="submit"
                class="px-4 py-2 rounded-lg bg-red-600 text-white font-medium cursor-pointer hover:bg-red-700 text-sm">
                Cancel Event
              </button>
            </form>
          <% } %>
        </div>
      <% } %>
    </div>

    <% if (pageError) { %>
      <div class="mb-4 p-3 border border-red-200 rounded-lg bg-red-50 text-red-700 text-sm">
        <%= pageError %>
      </div>
    <% } %>

    <p class="text-slate-700 mb-6"><%= event.description %></p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm text-slate-600">
      <div>
        <span class="font-semibold text-slate-800">Location</span>
        <p><%= event.location %></p>
      </div>
      <div>
        <span class="font-semibold text-slate-800">Category</span>
        <p><%= event.category.charAt(0).toUpperCase() + event.category.slice(1) %></p>
      </div>
      <div>
        <span class="font-semibold text-slate-800">Starts</span>
        <p><%= new Date(event.startDateTime).toLocaleString() %></p>
      </div>
      <div>
        <span class="font-semibold text-slate-800">Ends</span>
        <p><%= new Date(event.endDateTime).toLocaleString() %></p>
      </div>
      <div>
        <span class="font-semibold text-slate-800">Capacity</span>
        <p><%= event.maxCapacity !== null ? event.maxCapacity : "Unlimited" %></p>
      </div>
    </div>

    <% if (session.authenticatedUser && session.authenticatedUser.role === "user") { %>
      <!-- RSVP button — Feature 4 will fill this in -->
      <div class="mt-6">
        <button disabled
          class="px-5 py-2.5 rounded-lg bg-blue-100 text-blue-400 font-medium text-sm cursor-not-allowed">
          RSVP (coming soon)
        </button>
      </div>
    <% } %>

  </section>
<% } %>