<% if (pageError && !event) { %>
  <div class="mb-5 p-4 border rounded-xl" style="background: rgba(252,106,151,0.08); border-color: rgba(252,106,151,0.35); color: var(--clr-pink);">
    <p class="font-medium"><%= pageError %></p>
  </div>
<% } %>

<% if (event) { %>

  <div id="event-status-badge" class="relative rounded-2xl overflow-hidden mb-6 bg-gradient-to-br
    <%= event.status === 'published' ? 'from-blue-600 to-blue-800' :
        event.status === 'draft'     ? 'from-yellow-500 to-amber-600' :
        event.status === 'cancelled' ? 'from-slate-500 to-slate-700' :
                                       'from-slate-400 to-slate-600' %>
    shadow-xl p-8 text-white" style="border: 1.5px solid var(--border-card);">

    <div  class="mb-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest
        <%= event.status === 'published' ? 'bg-white/20 text-white' :
            event.status === 'draft'     ? 'bg-white/20 text-white' :
            event.status === 'cancelled' ? 'bg-white/20 text-white' :
                                           'bg-white/20 text-white' %>">
        <span class="w-1.5 h-1.5 rounded-full
          <%= event.status === 'published' ? 'bg-green-300' :
              event.status === 'draft'     ? 'bg-yellow-200' :
              event.status === 'cancelled' ? 'bg-red-300' :
                                             'bg-slate-300' %>">
        </span>
        <%= event.status.charAt(0).toUpperCase() + event.status.slice(1) %>
      </span>
    </div>

    <h1 class="text-3xl sm:text-4xl font-bold leading-tight mb-2"><%= event.title %></h1>

    <span class="inline-block px-2.5 py-0.5 rounded-full bg-white/15 text-white/90 text-xs font-medium">
      <%= event.category.charAt(0).toUpperCase() + event.category.slice(1) %>
    </span>

    <p class="mt-3 text-white/70 text-sm">Organized by <span class="text-white font-medium"><%= event.organizerName %></span></p>
  </div>

  <% if (pageError) { %>
    <div class="mb-5 p-4 border rounded-xl text-sm" style="background: rgba(252,106,151,0.08); border-color: rgba(252,106,151,0.35); color: var(--clr-pink);">
      <p class="font-medium"><%= pageError %></p>
    </div>
  <% } %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <%# ── Left column: main content ───────────────────────────────────── %>
    <div class="lg:col-span-2 space-y-5">

      <section class="eb-card p-6">
        <h2 class="text-xs font-bold uppercase tracking-widest mb-3" style="color: var(--text-muted);">Description</h2>
        <p class="leading-relaxed whitespace-pre-line" style="color: var(--text-primary);"><%= event.description %></p>
      </section>

      <%# Date & time card - Alpine.js labels %>
      <section class="eb-card p-6">
        <h2 class="text-xs font-bold uppercase tracking-widest mb-4" style="color: var(--text-muted);">Date &amp; Time</h2>

        <div class="flex items-start gap-4 mb-4"
          x-data="relativeTime('<%= new Date(event.startDateTime).toISOString() %>')"
          x-init="init()">
          <div class="flex-shrink-0 w-10 h-10 rounded-xl flex items-center justify-center" style="background: rgba(56,120,226,0.12); color: var(--clr-blue);">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide mb-0.5" style="color: var(--text-muted);">Starts</p>
            <p class="font-medium" style="color: var(--text-primary);"><%= new Date(event.startDateTime).toLocaleString() %></p>
            <p class="text-sm font-medium mt-0.5" style="color: var(--clr-blue);" x-text="label" x-show="label"></p>
          </div>
        </div>

        <div class="flex items-start gap-4"
          x-data="relativeTime('<%= new Date(event.endDateTime).toISOString() %>')"
          x-init="init()">
          <div class="flex-shrink-0 w-10 h-10 rounded-xl flex items-center justify-center" style="background: var(--bg-card-tint); color: var(--text-secondary);">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide mb-0.5" style="color: var(--text-muted);">Ends</p>
            <p class="font-medium" style="color: var(--text-primary);"><%= new Date(event.endDateTime).toLocaleString() %></p>
            <p class="text-sm mt-0.5" style="color: var(--text-muted);" x-text="label" x-show="label"></p>
          </div>
        </div>
      </section>

      <%# Location %>
      <section class="eb-card p-6">
        <h2 class="text-xs font-bold uppercase tracking-widest mb-4" style="color: var(--text-muted);">Location</h2>
        <div class="flex items-center gap-3">
          <div class="flex-shrink-0 w-10 h-10 rounded-xl flex items-center justify-center" style="background: rgba(72,199,142,0.14); color: #2a8a60;">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <p class="font-medium" style="color: var(--text-primary);"><%= event.location %></p>
        </div>
      </section>

    </div>

    <%# -- Right column: sidebar -- %>
    <div class="space-y-5">

      <%# Attendance card %>
      <section
        id="attendance-section"
        class="eb-card p-6"
        hx-get="/events/<%= event.id %>"
        hx-select="#attendance-section"
        hx-trigger="rsvp-updated from:body"
        hx-swap="outerHTML"
      >
        <%- include("../partials/event-attendance", { attendeeCount: event.attendeeCount, maxCapacity: event.maxCapacity }) %>
      </section>

      <%# Organizer actions card — staff/admin only %>
      <% const isOrganizerOrAdmin = session.authenticatedUser &&
           (session.authenticatedUser.role === "admin" ||
            (session.authenticatedUser.role === "staff" &&
             session.authenticatedUser.userId === event.organizerId)); %>

      <% if (isOrganizerOrAdmin) { %>
        <section class="eb-card p-6">
          <h2 class="text-xs font-bold uppercase tracking-widest mb-4" style="color: var(--text-muted);">Manage Event</h2>
          <%- include("../partials/event-actions", { event }) %>
        </section>
      <% } %>

      <%# RSVP section — members only %>
      
      <% if (session.authenticatedUser && session.authenticatedUser.role === "user") { %>
      <section class="eb-card p-6">
        <div
          id="rsvp-section"
          hx-get="/events/<%= event.id %>/rsvp-status"
          hx-trigger="load"
          hx-swap="outerHTML"
          class="animate-pulse">

        </div>
      </section>
        
      <% } %>

    </div>
  </div>

<% } %>

<script>
  function relativeTime(isoString) {
    return {
      label: '',
      init() {
        const target = new Date(isoString);
        const now = new Date();
        const diffMs = target - now;
        const diffSec = Math.round(diffMs / 1000);
        const diffMin = Math.round(diffSec / 60);
        const diffHr  = Math.round(diffMin / 60);
        const diffDay = Math.round(diffHr / 24);

        if (diffMs < 0) {
          const absDays = Math.round(Math.abs(diffMs) / 86400000);
          if (absDays === 0) this.label = 'earlier today';
          else if (absDays === 1) this.label = 'yesterday';
          else this.label = absDays + ' days ago';
          return;
        }

        if (diffMin < 1)        this.label = 'in less than a minute';
        else if (diffMin < 60)  this.label = 'in ' + diffMin + ' minute' + (diffMin === 1 ? '' : 's');
        else if (diffHr < 24)   this.label = 'in ' + diffHr + ' hour' + (diffHr === 1 ? '' : 's');
        else if (diffDay === 1) this.label = 'tomorrow';
        else if (diffDay < 7)   this.label = 'in ' + diffDay + ' days';
        else if (diffDay < 14)  this.label = 'next week';
        else if (diffDay < 31)  this.label = 'in ' + Math.round(diffDay / 7) + ' weeks';
        else if (diffDay < 365) this.label = 'in ' + Math.round(diffDay / 30) + ' month' + (Math.round(diffDay/30) === 1 ? '' : 's');
        else                    this.label = 'in ' + Math.round(diffDay / 365) + ' year' + (Math.round(diffDay/365) === 1 ? '' : 's');
      }
    }
  }
</script>
