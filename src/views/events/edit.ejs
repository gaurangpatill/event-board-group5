<h1>Edit Event</h1>

<% if (pageError) { %>
  <p style="color:red;"><%= pageError %></p>
<% } %>

<form method="POST" action="/events/<%= event.id %>">
  <input name="title" value="<%= values.title %>" required />
  <textarea name="description"><%= values.description %></textarea>
  <input name="location" value="<%= values.location %>" />

  <select name="category">
    <option value="academic" <%= values.category === "academic" ? "selected" : "" %>>Academic</option>
    <option value="social" <%= values.category === "social" ? "selected" : "" %>>Social</option>
    <option value="sports" <%= values.category === "sports" ? "selected" : "" %>>Sports</option>
    <option value="workshop" <%= values.category === "workshop" ? "selected" : "" %>>Workshop</option>
    <option value="other" <%= values.category === "other" ? "selected" : "" %>>Other</option>
  </select>

  <input type="datetime-local" name="startDateTime" value="<%= values.startDateTime %>" />
  <input type="datetime-local" name="endDateTime" value="<%= values.endDateTime %>" />

  <input name="maxCapacity" value="<%= values.maxCapacity %>" />

  <button type="submit">Update Event</button>
</form>