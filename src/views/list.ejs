<%# src/views/list.ejs — Feature 6: Event list + filter bar %>

<div class="mb-6 flex items-start justify-between gap-4 flex-wrap">
  <div>
    <h1 class="text-3xl font-bold mb-1" style="color: var(--text-primary);">Events</h1>
    <p class="text-sm" style="color: var(--text-muted);">Browse upcoming published events.</p>
  </div>
  <% if (session?.authenticatedUser && session.authenticatedUser.role === "staff") { %>
    <a href="/events/new" class="eb-btn-primary no-underline">+ Create Event</a>
  <% } %>
</div>

<!-- Filter bar — Feature 6 Sprint 4: Alpine.js "clear filters" + styled control group -->
<form
  method="GET"
  action="/events"
  x-data="{
    hasFilter: <%= (category || (timeframe && timeframe !== 'all') || q) ? 'true' : 'false' %>
  }"
  class="eb-card p-4 mb-6 flex flex-wrap gap-3 items-end"
  style="border-color: rgba(200,151,216,0.45);"
  hx-get="/events"
  hx-target="#event-list"
  hx-trigger="change"
  hx-include="[name='category'],[name='timeframe'],[name='q']"
  hx-push-url="true"
  @htmx:after-request.window="hasFilter = (
    document.getElementById('category').value !== '' ||
    (document.getElementById('timeframe').value !== 'all' && document.getElementById('timeframe').value !== '') ||
    document.getElementById('q').value !== ''
  )"
>
  <!-- Search -->
  <div class="flex-1 min-w-[220px] flex flex-col gap-1">
    <label for="q" class="eb-section-label">Search</label>
    <div x-data="{ query: '<%= (q || '').replace(/'/g, "\\'") %>' }" class="relative">
      <input
        id="q"
        name="q"
        type="search"
        x-model="query"
        value="<%= q ?? '' %>"
        placeholder="Title, description, or location…"
        class="eb-input pr-9 text-sm"
        hx-get="/events"
        hx-target="#event-list"
        hx-trigger="keyup changed delay:400ms"
        hx-include="[name='q'],[name='category'],[name='timeframe']"
        hx-push-url="true"
      />
      <button type="button"
        x-show="query.length > 0"
        @click="query = ''; document.getElementById('q').value = ''; htmx.trigger(document.getElementById('q'), 'keyup');"
        class="absolute right-3 top-1/2 -translate-y-1/2 text-lg leading-none focus:outline-none"
        style="color: var(--text-muted);"
        aria-label="Clear search">&times;</button>
    </div>
  </div>

  <!-- Category -->
  <div class="flex flex-col gap-1">
    <label for="category" class="eb-section-label">Category</label>
    <select name="category" id="category" class="eb-input text-sm" style="min-width: 9rem;">
      <option value=""           <%= !category ? "selected" : "" %>>All Categories</option>
      <option value="academic"   <%= category === "academic"  ? "selected" : "" %>>Academic</option>
      <option value="social"     <%= category === "social"    ? "selected" : "" %>>Social</option>
      <option value="sports"     <%= category === "sports"    ? "selected" : "" %>>Sports</option>
      <option value="workshop"   <%= category === "workshop"  ? "selected" : "" %>>Workshop</option>
      <option value="other"      <%= category === "other"     ? "selected" : "" %>>Other</option>
    </select>
  </div>

  <!-- Timeframe -->
  <div class="flex flex-col gap-1">
    <label for="timeframe" class="eb-section-label">When</label>
    <select name="timeframe" id="timeframe" class="eb-input text-sm" style="min-width: 8rem;">
      <option value="all"          <%= !timeframe || timeframe === "all" ? "selected" : "" %>>Any time</option>
      <option value="this_week"    <%= timeframe === "this_week"    ? "selected" : "" %>>This week</option>
      <option value="this_weekend" <%= timeframe === "this_weekend" ? "selected" : "" %>>This weekend</option>
    </select>
  </div>

  <!-- Clear filters — Alpine.js shows only when a filter is active -->
  
    <a href="/events"
    x-show="hasFilter"
    x-cloak
    class="eb-btn-outline text-sm no-underline self-end"
  >
    ✕ Clear filters
  </a>
</form>

<% if (pageError) { %>
  <div class="mb-4 p-4 rounded-xl border text-sm"
    style="background: rgba(252,106,151,0.08); border-color: rgba(252,106,151,0.35); color: var(--clr-pink);">
    <%= pageError %>
  </div>
<% } %>

<div id="event-list">
  <%- include("partials/event-list", { events, category, timeframe }) %>
</div>
