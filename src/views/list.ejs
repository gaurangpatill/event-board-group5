
<div class="mb-6 flex items-start justify-between gap-4 flex-wrap">
  <div>
    <h1 class="text-3xl font-bold mb-1" style="color: #33315A;">Events</h1>
    <p class="text-slate-500">Browse upcoming published events.</p>
  </div>

  <% if (session?.authenticatedUser && (session.authenticatedUser.role === "staff" || session.authenticatedUser.role === "admin")) { %>
    <a
      href="/events/new"
      class="px-4 py-2.5 rounded-xl text-white text-sm font-semibold no-underline transition"
      style="background-color: #3878E2;"
    >
      Create Event
    </a>
  <% } %>
</div>

<form
  method="GET"
  action="/events"
  x-data="{ hasFilter: <%= (category || (timeframe && timeframe !== 'all')) ? 'true' : 'false' %> }"
  class="mb-6 p-4 bg-white border-2 rounded-2xl shadow-sm flex flex-wrap gap-3 items-end"
  style="border-color: #C897D8;" 
  hx-get="/events"
  hx-target="#event-list"
  hx-trigger="change"
  hx-include="[name='category'],[name='timeframe']"
  hx-push-url="true"
  @htmx:after-request.window="hasFilter = (document.getElementById('category').value !== '' || (document.getElementById('timeframe').value !== 'all' && document.getElementById('timeframe').value !== ''))"
>
  <div class="flex-1 min-w-[240px] flex flex-col gap-1">
    <label for="q" class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Search</label>
    <input
      id="q"
      name="q"
      type="search"
      value="<%= q ?? "" %>"
      placeholder="Search title, description, or location"
      class="w-full px-3 py-2 rounded-lg border border-slate-200 text-sm text-slate-800 bg-white focus:outline-none focus:ring-2 focus:ring-blue-400"
    />
  </div>

  <div class="flex flex-col gap-1">
    <label for="category" class="text-xs font-semibold uppercase tracking-wide" style="color: #774C79;">Category</label>
    <select name="category" id="category" class="px-3 py-2 rounded-xl border-2 text-sm text-slate-800 bg-white focus:outline-none focus:ring-2 transition" style="border-color: #C897D8; focus-ring-color: #774C79;">
      <option value="" <%= !category ? "selected" : "" %>>All Categories</option>
      <option value="academic"  <%= category === "academic"  ? "selected" : "" %>>Academic</option>
      <option value="social"    <%= category === "social"    ? "selected" : "" %>>Social</option>
      <option value="sports"    <%= category === "sports"    ? "selected" : "" %>>Sports</option>
      <option value="workshop"  <%= category === "workshop"  ? "selected" : "" %>>Workshop</option>
      <option value="other"     <%= category === "other"     ? "selected" : "" %>>Other</option>
    </select>
  </div>

  <div class="flex flex-col gap-1">
    <label for="timeframe" class="text-xs font-semibold uppercase tracking-wide" style="color: #774C79;">When</label>
    <select name="timeframe" id="timeframe" class="px-3 py-2 rounded-xl border-2 text-sm text-slate-800 bg-white focus:outline-none focus:ring-2 transition" style="border-color: #C897D8;">  
      <option value="all"          <%= !timeframe || timeframe === "all" ? "selected" : "" %>>Any time</option>
      <option value="this_week"    <%= timeframe === "this_week"    ? "selected" : "" %>>This week</option>
      <option value="this_weekend" <%= timeframe === "this_weekend" ? "selected" : "" %>>This weekend</option>
    </select>
  </div>

  <button type="submit" class="px-4 py-2 rounded-xl text-white text-sm font-semibold cursor-pointer transition" style="background-color: #3878E2;"></button>
  Filter
  </button>
  <a
    href="/events"
    x-show="hasFilter"
    x-cloak
    class="px-4 py-2 rounded-lg bg-white border text-sm font-medium no-underline cursor-pointer"
    style="border-color: #C897D8; color: #774C79;"
  >
    Clear filters
  </a>
</form>

<% if (pageError) { %>
  <div class="mb-4 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm">
    <%= pageError %>
  </div>
<% } %>

<div id="event-list">
  <%- include("partials/event-list", { events, category, timeframe }) %>
</div>
