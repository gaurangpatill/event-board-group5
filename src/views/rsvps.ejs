<%# src/views/rsvps.ejs — Feature 7: My RSVPs Dashboard %>

<div class="mb-6">
  <h1 class="text-3xl font-bold mb-1" style="color: var(--text-primary);">My RSVPs</h1>
  <p class="text-sm" style="color: var(--text-muted);">All events you have RSVPed to.</p>
</div>

<% if (pageError) { %>
  <div class="mb-4 p-4 rounded-xl border text-sm"
    style="background: rgba(252,106,151,0.08); border-color: rgba(252,106,151,0.35); color: var(--clr-pink);">
    <%= pageError %>
  </div>
<% } %>

<% if (!rsvps || rsvps.length === 0) { %>
  <div class="eb-card p-8 text-center">
    <p class="text-sm" style="color: var(--text-muted);">You have not RSVPed to any events yet.</p>
    <a href="/events" class="mt-3 inline-block text-sm font-semibold hover:underline no-underline" style="color: var(--clr-blue);">
      Browse events
    </a>
  </div>
<% } else { %>

  <%
    const going      = rsvps.filter(function(r) { return r.rsvp.status === "going"; });
    const waitlisted = rsvps.filter(function(r) { return r.rsvp.status === "waitlisted"; });
    const cancelled  = rsvps.filter(function(r) { return r.rsvp.status === "cancelled"; });
  %>

  <!-- Going section: distinct blue-tinted treatment -->
  <% if (going.length > 0) { %>
    <section class="mb-8">
      <div class="flex items-center gap-2 mb-3">
        <span class="w-3 h-3 rounded-full" style="background: linear-gradient(135deg, #3878E2, #5B4E8A);"></span>
        <h2 class="text-base font-bold" style="color: var(--text-primary);">
          Going
          <span class="ml-1 px-2 py-0.5 rounded-full text-xs font-semibold"
            style="background: rgba(56,120,226,0.13); color: var(--clr-blue);"><%= going.length %></span>
        </h2>
      </div>
      <div class="grid gap-4">
        <% going.forEach(function(item) { %>
          <%- include("partials/rsvp-card", { item: item, statusColor: "green" }) %>
        <% }); %>
      </div>
    </section>
  <% } %>

  <!-- Waitlisted section: lavender-tinted treatment -->
  <% if (waitlisted.length > 0) { %>
    <section class="mb-8">
      <div class="flex items-center gap-2 mb-3">
        <span class="w-3 h-3 rounded-full" style="background: linear-gradient(135deg, #C897D8, #FC6A97);"></span>
        <h2 class="text-base font-bold" style="color: var(--text-primary);">
          Waitlisted
          <span class="ml-1 px-2 py-0.5 rounded-full text-xs font-semibold status-waitlisted"><%= waitlisted.length %></span>
        </h2>
      </div>
      <div class="grid gap-4">
        <% waitlisted.forEach(function(item) { %>
          <%- include("partials/rsvp-card", { item: item, statusColor: "yellow" }) %>
        <% }); %>
      </div>
    </section>
  <% } %>

  <!-- Cancelled section: muted/greyed treatment -->
  <% if (cancelled.length > 0) { %>
    <section class="mb-8">
      <div class="flex items-center gap-2 mb-3">
        <span class="w-3 h-3 rounded-full" style="background: var(--text-muted); opacity: 0.5;"></span>
        <h2 class="text-base font-bold" style="color: var(--text-muted);">
          Cancelled
          <span class="ml-1 px-2 py-0.5 rounded-full text-xs font-semibold status-cancelled"><%= cancelled.length %></span>
        </h2>
      </div>
      <div class="grid gap-4 opacity-70">
        <% cancelled.forEach(function(item) { %>
          <%- include("partials/rsvp-card", { item: item, statusColor: "slate" }) %>
        <% }); %>
      </div>
    </section>
  <% } %>

<% } %>