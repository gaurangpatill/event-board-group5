<%# src/views/auth/login.ejs %>

<div class="mb-5 eb-card eb-card-tint p-6" style="border-color: rgba(200,151,216,0.45);">
  <h1 class="text-3xl font-bold mb-2" style="color: var(--text-primary);">Sign In</h1>
  <p class="text-sm" style="color: var(--text-muted);">Log in with one of the demo accounts to access EventBoard.</p>
</div>

<% if (pageError) { %>
  <%- include("partials/error", { message: pageError }) %>
<% } %>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">

  <!-- Login form -->
  <section class="eb-card p-6">
    <h2 class="text-xl font-bold mb-4" style="color: var(--text-primary);">Log In</h2>
    <form class="grid gap-3" method="post" action="/login">
      <div>
        <label for="email" class="block text-sm font-semibold mb-1" style="color: var(--text-secondary);">Email</label>
        <input id="email" name="email" type="email" autocomplete="username" required class="eb-input text-sm" />
      </div>
      <div>
        <label for="password" class="block text-sm font-semibold mb-1" style="color: var(--text-secondary);">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required class="eb-input text-sm" />
      </div>
      <button type="submit" class="eb-btn-primary mt-1 w-full text-center">Log in</button>
    </form>
  </section>

  <!-- Demo accounts -->
  <section class="eb-card p-6" style="background: var(--bg-card-tint);">
    <h3 class="text-base font-bold mb-3" style="color: var(--text-primary);">Demo Accounts</h3>
    <div class="grid gap-3">
      <% [
        { email: 'admin@app.test', role: 'Admin',  color: 'var(--clr-pink)' },
        { email: 'staff@app.test', role: 'Staff',  color: 'var(--clr-blue)' },
        { email: 'user@app.test',  role: 'Member', color: 'var(--clr-mauve)' }
      ].forEach(function(u) { %>
        <div class="flex items-center justify-between gap-3 p-3 rounded-xl border"
          style="border-color: var(--border-card); background: var(--bg-card);">
          <div>
            <p class="text-xs font-bold mb-0.5" style="color: <%= u.color %>;"><%= u.role %></p>
            <p class="text-xs font-mono" style="color: var(--text-primary);"><%= u.email %></p>
            <p class="text-xs" style="color: var(--text-muted);">password123</p>
          </div>
          <span class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold text-white"
            style="background: linear-gradient(135deg, <%= u.color %>, var(--clr-dusk));">
            <%= u.role[0] %>
          </span>
        </div>
      <% }); %>
    </div>
  </section>
</div>