<div id="dashboard-table" x-data="{ openMenuId: null }" class = "max-w-5xl mx-auto p-3 sm:p-6 space-y-6 sm:space-y-10">
    <!-- Published Events-->
    <section>
        <h2 class = "text-lg sm:text-xl font-semibold mb-2 sm:mb-3 text-center sm:text-left">Published Events <span class = "text-gray-400 text-sm font-normal">(<%= dashboard.published.length %>)</span></h2>
        <div class = "rounded-lg border overflow-hidden" style="border-color: #3878E2">
            <table class = "w-full text-xs sm:text-sm">
                <thead class = "uppercase text-xs text-white" style="background-color: #3878E2">
                    <tr>
                        <th class = "px-2 sm:px-4 py-2.5 sm:py-3 text-left">Title</th>
                        <th class = "px-2 sm:px-4 py-2.5 sm:py-3 text-left">Date</th>
                        <th class = "px-2 sm:px-4 py-2.5 sm:py-3 text-left">Attendees</th>
                        <th class = "px-2 sm:px-4 py-2.5 sm:py-3 text-left">Actions</th>
                    </tr>
                </thead>
                <tbody class = "divide-y divide-gray-100 bg-blue-50">
                    <% for (const event of dashboard.published) { %>
                    <tr id="event-row-<%= event.id %>" @click="openMenuId = null" class="transition-colors hover:bg-blue-100 active:bg-blue-200 focus-within:bg-blue-100">
                        <td class="px-2 sm:px-4 py-2.5 sm:py-3 font-medium"><a href="/events/<%= event.id %>" class="hover:underline"><%= event.title %></a></td>
                        <td class="px-2 sm:px-4 py-2.5 sm:py-3 text-gray-500"><%= event.startDateTime.toLocaleDateString() %></td>
                        <td class="px-2 sm:px-4 py-2.5 sm:py-3 text-gray-500"><%= event.attendeeCount %><%if (event.maxCapacity) {%> / <%=event.maxCapacity %><%} %></td>
                        <td class="px-2 sm:px-4 py-2.5 sm:py-3 align-top">
                            <div class="hidden md:flex gap-2">
                                <a href="/events/<%= event.id %>/edit" class="text-blue-600 hover:underline">Edit</a>
                                <form method="POST" action="/events/<%= event.id %>/cancel"
                                    hx-post="/events/<%= event.id %>/cancel"
                                    hx-target="#dashboard-table"
                                    hx-swap="outerHTML">
                                    <button type="submit" class="text-red-500 hover:underline">Cancel</button>
                                </form>
                            </div>
                                                        <div class="md:hidden text-right" @click.stop>
                                                                <button
                                                                    type="button"
                                                                    class="inline-flex items-center justify-end min-w-14 text-blue-700 font-medium"
                                                                    @click.stop="openMenuId = openMenuId === '<%= event.id %>-published' ? null : '<%= event.id %>-published'"
                                                                    :aria-expanded="(openMenuId === '<%= event.id %>-published').toString()"
                                                                    aria-label="Toggle row actions"
                                                                >
                                                                    <span x-show="openMenuId !== '<%= event.id %>-published'" x-cloak>Actions</span>
                                                                </button>
                                                                <div
                                                                    x-show="openMenuId === '<%= event.id %>-published'"
                                                                    x-cloak
                                                                    class="mt-1 inline-flex flex-col items-end gap-0.5"
                                                                >
                                                                    <a href="/events/<%= event.id %>/edit" class="text-blue-600 hover:underline">Edit</a>
                                                                    <form method="POST" action="/events/<%= event.id %>/cancel" @click.stop
                                                                        hx-post="/events/<%= event.id %>/cancel"
                                                                        hx-target="#dashboard-table"
                                                                        hx-swap="outerHTML">
                                                                        <button type="submit" class="text-red-500 hover:underline">Cancel</button>
                                                                    </form>
                                                                </div>
                                                        </div>
                        </td>
                    </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </section>

    <!-- Draft Events-->
    <section>
        <h2 class="text-lg sm:text-xl font-semibold mb-2 sm:mb-3 text-center sm:text-left">Drafts <span class="text-gray-400 text-sm font-normal">(<%= dashboard.draft.length %>)</span></h2>
        <div class="rounded-lg border overflow-hidden" style="border-color: #C897D8">
            <table class="w-full text-xs sm:text-sm">
                <thead class="uppercase text-xs text-white" style="background-color: #C897D8">
                    <tr>
                        <th class="px-2 sm:px-4 py-2.5 sm:py-3 text-left">Title</th>
                        <th class="px-2 sm:px-4 py-2.5 sm:py-3 text-left">Created</th>
                        <th class="px-2 sm:px-4 py-2.5 sm:py-3 text-left">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 bg-purple-50">
                    <% for (const event of dashboard.draft) { %>
                    <tr id="event-row-<%= event.id %>" @click="openMenuId = null" class="transition-colors hover:bg-purple-100 active:bg-purple-200 focus-within:bg-purple-100">
                        <td class="px-2 sm:px-4 py-2.5 sm:py-3 font-medium"><a href="/events/<%= event.id %>" class="hover:underline"><%= event.title %></a></td>
                        <td class="px-2 sm:px-4 py-2.5 sm:py-3 text-gray-500"><%= event.createdAt.toLocaleDateString() %></td>
                        <td class="px-2 sm:px-4 py-2.5 sm:py-3 align-top">
                            <div class="hidden md:flex gap-2">
                                <a href="/events/<%= event.id %>/edit" class="text-blue-600 hover:underline">Edit</a>
                                <form method="POST" action="/events/<%= event.id %>/publish"
                                    hx-post="/events/<%= event.id %>/publish"
                                    hx-target="#dashboard-table"
                                    hx-swap="outerHTML">
                                    <button type="submit" class="text-green-600 hover:underline">Publish</button>
                                </form>
                            </div>
                                                        <div class="md:hidden text-right" @click.stop>
                                                                <button
                                                                    type="button"
                                                                    class="inline-flex items-center justify-end min-w-14 text-blue-700 font-medium"
                                                                    @click.stop="openMenuId = openMenuId === '<%= event.id %>-draft' ? null : '<%= event.id %>-draft'"
                                                                    :aria-expanded="(openMenuId === '<%= event.id %>-draft').toString()"
                                                                    aria-label="Toggle row actions"
                                                                >
                                                                    <span x-show="openMenuId !== '<%= event.id %>-draft'" x-cloak>Actions</span>
                                                                </button>
                                                                <div
                                                                    x-show="openMenuId === '<%= event.id %>-draft'"
                                                                    x-cloak
                                                                    class="mt-1 inline-flex flex-col items-end gap-0.5"
                                                                >
                                                                    <a href="/events/<%= event.id %>/edit" class="text-blue-600 hover:underline">Edit</a>
                                                                    <form method="POST" action="/events/<%= event.id %>/publish" @click.stop
                                                                        hx-post="/events/<%= event.id %>/publish"
                                                                        hx-target="#dashboard-table"
                                                                        hx-swap="outerHTML">
                                                                        <button type="submit" class="text-green-600 hover:underline">Publish</button>
                                                                    </form>
                                                                </div>
                                                        </div>
                        </td>
                    </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </section>

    <!-- Canceled & Past Events-->
    <section x-data="{ open: false }">
        <button type="button" @click="open = !open" class="flex items-center justify-between w-full text-left mb-3">
            <span class="text-lg sm:text-xl font-semibold text-gray-400 text-center sm:text-left w-full">Cancelled & Past <span class="text-gray-400 text-sm font-normal">(<%= dashboard.cancelledOrPast.length %>)</span></span>
            <span class="text-slate-400 text-sm font-medium shrink-0 whitespace-nowrap" x-text="open ? 'Collapse' : 'Expand'"></span>
        </button>
        <div x-show="open" x-cloak x-collapse>
            <div class="rounded-lg border border-gray-200 overflow-hidden">
                <table class="w-full text-xs sm:text-sm">
                    <thead class="bg-gray-50 text-gray-500 uppercase text-xs">
                        <tr>
                            <th class="px-2 sm:px-4 py-2.5 sm:py-3 text-left">Title</th>
                            <th class="px-2 sm:px-4 py-2.5 sm:py-3 text-left">Status</th>
                            <th class="px-2 sm:px-4 py-2.5 sm:py-3 text-left">Date</th>
                            <th class="px-2 sm:px-4 py-2.5 sm:py-3 text-left">Attendees</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 bg-gray-50">
                        <% for (const event of dashboard.cancelledOrPast) { %>
                        <tr class="transition-colors hover:bg-gray-100 active:bg-gray-200 focus-within:bg-gray-100 text-gray-400">
                            <td class="px-2 sm:px-4 py-2.5 sm:py-3"><a href="/events/<%= event.id %>" class="hover:underline"><%= event.title %></a></td>
                            <td class="px-2 sm:px-4 py-2.5 sm:py-3 capitalize"><%= event.status %></td>
                            <td class="px-2 sm:px-4 py-2.5 sm:py-3"><%= event.startDateTime.toLocaleDateString() %></td>
                            <td class="px-2 sm:px-4 py-2.5 sm:py-3"><%= event.attendeeCount %></td>
                        </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>
