    class="inline-flex items-center gap-1 rounded-full border border-yellow-300 bg-yellow-50 px-2 py-0.5 text-[11px] sm:gap-1.5 sm:px-2.5 sm:py-1 sm:text-xs font-semibold text-yellow-900 ring-1 ring-yellow-200 whitespace-nowrap"
  >
    <span class="uppercase tracking-normal sm:tracking-wide text-yellow-700">Waitlist</span>
    <span class="text-yellow-900">#<%= position %></span>
  </div>
<% } %>
