<%# Primary swap — replaces #event-actions %>
<div class="space-y-2" id="event-actions">
  <% if (event.status === "draft") { %>
    <div x-data="{ loading: false }">
      <form method="POST" action="/events/<%= event.id %>/publish" class="m-0"
        hx-post="/events/<%= event.id %>/publish"
        hx-target="#event-actions"
        hx-swap="outerHTML"
        @submit="loading = true"
        hx-on::after-request="loading = false">
        <button type="submit"
          :disabled="loading"
          :class="loading ? 'opacity-60 cursor-not-allowed scale-95' : 'hover:bg-green-700 hover:scale-105 active:scale-95'"
          class="w-full px-4 py-2.5 rounded-xl bg-green-600 text-white font-semibold text-sm transition-all duration-150 flex items-center justify-center gap-2">
          <svg x-show="loading" class="animate-spin w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
          </svg>
          <span x-text="loading ? 'Publishing...' : 'Publish Event'"></span>
        </button>
      </form>
      <a href="/events/<%= event.id %>/edit"
        class="block w-full px-4 py-2.5 rounded-xl border border-slate-200 text-slate-700 font-semibold text-sm text-center no-underline hover:bg-slate-50 transition-colors mt-2">
        Edit Event
      </a>
    </div>
  <% } %>
  <% if (event.status === "published") { %>
    <div x-data="{ loading: false }">
      <form method="POST" action="/events/<%= event.id %>/cancel" class="m-0"
        hx-post="/events/<%= event.id %>/cancel"
        hx-target="#event-actions"
        hx-swap="outerHTML"
        @submit="loading = true"
        hx-on::after-request="loading = false">
        <button type="submit"
          :disabled="loading"
          :class="loading ? 'opacity-60 cursor-not-allowed scale-95' : 'hover:bg-red-700 hover:scale-105 active:scale-95'"
          class="w-full px-4 py-2.5 rounded-xl bg-red-600 text-white font-semibold text-sm transition-all duration-150 flex items-center justify-center gap-2">
          <svg x-show="loading" class="animate-spin w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
          </svg>
          <span x-text="loading ? 'Cancelling...' : 'Cancel Event'"></span>
        </button>
      </form>
      <a href="/events/<%= event.id %>/edit"
        class="block w-full px-4 py-2.5 rounded-xl border border-slate-200 text-slate-700 font-semibold text-sm text-center no-underline hover:bg-slate-50 transition-colors mt-2">
        Edit Event
      </a>
    </div>
  <% } %>
  <% if (event.status === "cancelled" || event.status === "past") { %>
    <p class="text-sm text-slate-400 text-center py-2">No actions available</p>
  <% } %>
</div>

<%# Out-of-band swap — updates #event-status-badge anywhere on the page %>
<div id="event-status-badge" class="relative rounded-2xl overflow-hidden mb-6 bg-gradient-to-br
    <%= event.status === 'published' ? 'from-blue-600 to-blue-800' :
        event.status === 'draft'     ? 'from-yellow-500 to-amber-600' :
        event.status === 'cancelled' ? 'from-slate-500 to-slate-700' :
                                       'from-slate-400 to-slate-600' %>
    shadow-xl p-8 text-white" hx-swap-oob="true">

    <div class="mb-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest
        <%= event.status === 'published' ? 'bg-white/20 text-white' :
            event.status === 'draft'     ? 'bg-white/20 text-white' :
            event.status === 'cancelled' ? 'bg-white/20 text-white' :
                                           'bg-white/20 text-white' %>">
        <span class="w-1.5 h-1.5 rounded-full
          <%= event.status === 'published' ? 'bg-green-300' :
              event.status === 'draft'     ? 'bg-yellow-200' :
              event.status === 'cancelled' ? 'bg-red-300' :
                                             'bg-slate-300' %>">
        </span>
        <%= event.status.charAt(0).toUpperCase() + event.status.slice(1) %>
      </span>
    </div>

    <h1 class="text-3xl sm:text-4xl font-bold leading-tight mb-2"><%= event.title %></h1>

    <span class="inline-block px-2.5 py-0.5 rounded-full bg-white/15 text-white/90 text-xs font-medium">
      <%= event.category.charAt(0).toUpperCase() + event.category.slice(1) %>
    </span>

    <p class="mt-3 text-white/70 text-sm">Organized by <span class="text-white font-medium"><%= event.organizerName %></span></p>
  </div>