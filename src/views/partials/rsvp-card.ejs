<%# src/views/dashboard/partials/rsvp-card.ejs %>

<article
  x-data="{ confirming: false }"
  class="p-5 bg-white border-2 rounded-2xl shadow-sm hover:shadow-md transition-shadow"
  style="border-color: #C897D8;">
  <div class="flex items-start justify-between gap-4 flex-wrap">
    <div class="flex-1 min-w-0">

      <span class="inline-block mb-2 px-2 py-0.5 rounded-full text-xs font-semibold
        <% if (item.event.category === 'academic')       { %>bg-blue-100 text-blue-700<%
           } else if (item.event.category === 'social')  { %>bg-green-100 text-green-700<%
           } else if (item.event.category === 'sports')  { %>bg-orange-100 text-orange-700<%
           } else if (item.event.category === 'workshop'){ %>bg-purple-100 text-purple-700<%
           } else                                        { %>bg-slate-100 text-slate-600<% } %>
      ">
        <%= item.event.category.charAt(0).toUpperCase() + item.event.category.slice(1) %>
      </span>

      <h3 class="text-base font-bold text-slate-900 leading-snug mb-1">
        <a href="/events/<%= item.event.id %>" 
          class="no-underline hover:underline text-slate-900">
          <%= item.event.title %>
        </a>
      </h3>

      <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-500 mb-2">
        <span>📍 <%= item.event.location %></span>
        <span>
          📅 <%= new Date(item.event.startDateTime).toLocaleDateString("en-US", { weekday: "short", month: "short", day: "numeric" }) %>
          &nbsp;·&nbsp;
          <%= new Date(item.event.startDateTime).toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" }) %>
        </span>
      </div>

      <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold
        <% if (statusColor === 'green')       { %>bg-green-100 text-green-700<%
           } else if (statusColor === 'yellow') { %>bg-yellow-100 text-yellow-700<%
           } else                               { %>bg-slate-100 text-slate-500<% } %>
      ">
        <%= item.rsvp.status.charAt(0).toUpperCase() + item.rsvp.status.slice(1) %>
      </span>

    </div>

    <div class="flex flex-col gap-2 items-end shrink-0">
      
    <a  href="/events/<%= item.event.id %>"
        class="px-4 py-2 rounded-xl border-2 text-sm font-semibold no-underline transition"
        style="border-color: #C897D8; color: #774C79; background: white;"
      >
        View event
      </a>

      <% if (item.rsvp.status !== "cancelled") { %>

        <button
          x-show="!confirming"
          x-cloak
          type="button"
          @click="confirming = true"
          class="px-4 py-2 rounded-xl border-2 text-sm font-semibold cursor-pointer transition"
          style="border-color: #FC6A97; color: #FC6A97; background: white;"
        >
          Cancel RSVP
        </button>

        <div
          x-show="confirming"
          x-cloak
          class="flex flex-col gap-2 items-end p-3 rounded-xl border-2"
          style="background-color: #fff0f4; border-color: #FC6A97;"
        >
          <p class="text-xs font-semibold text-right" style="color: #774C79;">
            &#9888; This will cancel your spot. Are you sure?
          </p>
          <div class="flex gap-2">
            <button
              type="button"
              @click="confirming = false"
              class="px-3 py-1.5 rounded-lg bg-white border text-sm font-medium cursor-pointer transition"
              style="border-color: #C897D8; color: #774C79;"
            >
              Go back
            </button>
            <button
              hx-post="/events/<%= item.event.id %>/rsvp"
              hx-target="closest article"
              hx-swap="outerHTML"
              class="px-3 py-1.5 rounded-lg text-white text-sm font-semibold cursor-pointer transition"
              style="background-color: #FC6A97;"
            >
              Confirm cancel
            </button>
          </div>
        </div>

      <% } else { %>
        <button
          hx-post="/events/<%= item.event.id %>/rsvp"
          hx-target="closest article"
          hx-swap="outerHTML"
          class="px-4 py-2 rounded-xl text-white text-sm font-semibold cursor-pointer transition"
          style="background-color: #3878E2;"
        >
          RSVP again
        </button>
      <% } %>
    </div>
  </div>
</article>