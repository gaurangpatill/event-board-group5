<%# src/views/dashboard/partials/rsvp-card.ejs %>

<article class="p-5 bg-white border border-slate-200 rounded-2xl shadow-sm">
  <div class="flex items-start justify-between gap-4 flex-wrap">
    <div class="flex-1 min-w-0">

      <span class="inline-block mb-2 px-2 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600">
        <%= item.event.category %>
      </span>

      <h3 class="text-base font-bold text-slate-900 leading-snug mb-1">
        <a href="/events/<%= item.event.id %>" class="no-underline hover:underline text-slate-900">
          <%= item.event.title %>
        </a>
      </h3>

      <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-500 mb-2">
        <span>📍 <%= item.event.location %></span>
        <span>📅 <%= new Date(item.event.startDateTime).toLocaleDateString() %></span>
      </div>

      <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-500">
        <%= item.rsvp.status %>
      </span>

    </div>

    <div class="flex flex-col gap-2 items-end shrink-0">
      
        href="/events/<%= item.event.id %>"
        class="px-4 py-2 rounded-lg bg-slate-100 text-slate-700 text-sm font-medium hover:bg-slate-200 no-underline"
      >
        View event
      </a>
    </div>
  </div>
</article>