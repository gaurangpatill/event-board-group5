<section
  id="event-create-form"
  class="overflow-hidden rounded-lg border border-[#C897D8]/50 bg-white shadow-md shadow-[#33315A]/10 dark:border-[#C897D8]/25 dark:bg-[#231f38] dark:shadow-[#000]/25"
  x-data="{ descriptionCount: <%= JSON.stringify((values.description || '').length) %>, descriptionMax: 2000 }"
>
  <div class="h-1.5 bg-gradient-to-r from-[#3878E2] via-[#C897D8] to-[#FC6A97]"></div>
  <div class="border-b border-[#C897D8]/30 bg-gradient-to-r from-[#C897D8]/20 via-white to-[#3878E2]/10 px-5 py-4 sm:px-7 dark:border-[#C897D8]/20 dark:from-[#C897D8]/10 dark:via-[#231f38] dark:to-[#3878E2]/10">
    <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-lg font-semibold text-[#33315A] dark:text-[#e8e4f8]">Event Details</h2>
        <p class="text-sm text-[#774C79] dark:text-[#C897D8]">All fields can be edited before publication.</p>
      </div>
      <span class="mt-2 inline-flex w-fit rounded-full bg-white px-3 py-1 text-xs font-semibold text-[#774C79] ring-1 ring-[#C897D8]/60 sm:mt-0 dark:bg-[#2a2540] dark:text-[#C897D8] dark:ring-[#C897D8]/30">
        Draft
      </span>
    </div>
  </div>

  <div class="p-5 sm:p-7">
  <% if (pageError) { %>
    <div class="mb-6">
      <%- include("./error", { message: pageError }) %>
    </div>
  <% } %>

  <form
    method="POST"
    action="/events"
    class="space-y-6"
    hx-post="/events"
    hx-target="#event-create-form"
    hx-swap="outerHTML"
  >
    <div class="rounded-lg border border-[#C897D8]/30 bg-[#C897D8]/10 p-4 dark:border-[#C897D8]/20 dark:bg-[#C897D8]/5">
      <div class="mb-4 flex items-center gap-2">
        <span class="h-2.5 w-2.5 rounded-full bg-[#3878E2]"></span>
        <h3 class="text-sm font-bold uppercase tracking-wide text-[#33315A] dark:text-[#e8e4f8]">Basics</h3>
      </div>
      <div class="space-y-2">
      <label for="title" class="block text-sm font-semibold text-[#33315A] dark:text-[#e8e4f8]">Title</label>
      <input
        id="title"
        name="title"
        type="text"
        value="<%= values.title %>"
        required
        class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-[#33315A] shadow-sm outline-none transition placeholder:text-slate-400 focus:border-[#3878E2] focus:ring-2 focus:ring-[#C897D8]/70 dark:border-[#C897D8]/25 dark:bg-[#2a2540] dark:text-[#e8e4f8] dark:placeholder:text-[#8a86aa]"
      />
      </div>
    </div>

    <div class="rounded-lg border border-[#FC6A97]/25 bg-[#FC6A97]/5 p-4 dark:border-[#FC6A97]/20 dark:bg-[#FC6A97]/5">
      <div class="mb-4 flex items-center gap-2">
        <span class="h-2.5 w-2.5 rounded-full bg-[#FC6A97]"></span>
        <h3 class="text-sm font-bold uppercase tracking-wide text-[#33315A] dark:text-[#e8e4f8]">Description</h3>
      </div>
      <div class="space-y-2">
      <div class="flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between">
        <label for="description" class="block text-sm font-semibold text-[#33315A] dark:text-[#e8e4f8]">Description</label>
        <p
          class="text-sm font-medium"
          x-bind:class="descriptionCount > descriptionMax ? 'text-[#FC6A97]' : 'text-[#774C79] dark:text-[#C897D8]'"
        >
          <span x-text="descriptionCount"></span> / <span x-text="descriptionMax"></span> characters
        </p>
      </div>
      <textarea
        id="description"
        name="description"
        rows="5"
        maxlength="2000"
        x-on:input="descriptionCount = $event.target.value.length"
        class="min-h-36 w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-[#33315A] shadow-sm outline-none transition placeholder:text-slate-400 focus:border-[#3878E2] focus:ring-2 focus:ring-[#C897D8]/70 dark:border-[#C897D8]/25 dark:bg-[#2a2540] dark:text-[#e8e4f8] dark:placeholder:text-[#8a86aa]"
      ><%= values.description %></textarea>
      </div>
    </div>

    <div class="rounded-lg border border-[#3878E2]/25 bg-[#3878E2]/5 p-4 dark:border-[#3878E2]/25 dark:bg-[#3878E2]/10">
      <div class="mb-4 flex items-center gap-2">
        <span class="h-2.5 w-2.5 rounded-full bg-[#774C79]"></span>
        <h3 class="text-sm font-bold uppercase tracking-wide text-[#33315A] dark:text-[#e8e4f8]">Place and Category</h3>
      </div>
      <div class="grid gap-5 md:grid-cols-2">
      <div class="space-y-2">
        <label for="location" class="block text-sm font-semibold text-[#33315A] dark:text-[#e8e4f8]">Location</label>
        <input
          id="location"
          name="location"
          type="text"
          value="<%= values.location %>"
          class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-[#33315A] shadow-sm outline-none transition placeholder:text-slate-400 focus:border-[#3878E2] focus:ring-2 focus:ring-[#C897D8]/70 dark:border-[#C897D8]/25 dark:bg-[#2a2540] dark:text-[#e8e4f8] dark:placeholder:text-[#8a86aa]"
        />
      </div>

      <div class="space-y-2">
        <label for="category" class="block text-sm font-semibold text-[#33315A] dark:text-[#e8e4f8]">Category</label>
        <select
          id="category"
          name="category"
          class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-[#33315A] shadow-sm outline-none transition focus:border-[#3878E2] focus:ring-2 focus:ring-[#C897D8]/70 dark:border-[#C897D8]/25 dark:bg-[#2a2540] dark:text-[#e8e4f8]"
        >
          <option value="academic" <%= values.category === "academic" ? "selected" : "" %>>Academic</option>
          <option value="social" <%= values.category === "social" ? "selected" : "" %>>Social</option>
          <option value="sports" <%= values.category === "sports" ? "selected" : "" %>>Sports</option>
          <option value="workshop" <%= values.category === "workshop" ? "selected" : "" %>>Workshop</option>
          <option value="other" <%= values.category === "other" ? "selected" : "" %>>Other</option>
        </select>
      </div>
      </div>
    </div>

    <div class="rounded-lg border border-[#774C79]/25 bg-[#774C79]/5 p-4 dark:border-[#774C79]/30 dark:bg-[#774C79]/10">
      <div class="mb-4 flex items-center gap-2">
        <span class="h-2.5 w-2.5 rounded-full bg-[#C897D8]"></span>
        <h3 class="text-sm font-bold uppercase tracking-wide text-[#33315A] dark:text-[#e8e4f8]">Schedule</h3>
      </div>
      <div class="grid gap-5 md:grid-cols-2">
      <div class="space-y-2">
        <label for="startDateTime" class="block text-sm font-semibold text-[#33315A] dark:text-[#e8e4f8]">Start</label>
        <input
          id="startDateTime"
          name="startDateTime"
          type="datetime-local"
          value="<%= values.startDateTime %>"
          class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-[#33315A] shadow-sm outline-none transition focus:border-[#3878E2] focus:ring-2 focus:ring-[#C897D8]/70 dark:border-[#C897D8]/25 dark:bg-[#2a2540] dark:text-[#e8e4f8]"
        />
      </div>

      <div class="space-y-2">
        <label for="endDateTime" class="block text-sm font-semibold text-[#33315A] dark:text-[#e8e4f8]">End</label>
        <input
          id="endDateTime"
          name="endDateTime"
          type="datetime-local"
          value="<%= values.endDateTime %>"
          class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-[#33315A] shadow-sm outline-none transition focus:border-[#3878E2] focus:ring-2 focus:ring-[#C897D8]/70 dark:border-[#C897D8]/25 dark:bg-[#2a2540] dark:text-[#e8e4f8]"
        />
      </div>
      </div>
    </div>

    <div class="rounded-lg border border-[#C897D8]/30 bg-gradient-to-r from-[#C897D8]/10 to-[#FC6A97]/5 p-4 dark:border-[#C897D8]/20 dark:from-[#C897D8]/5 dark:to-[#FC6A97]/5">
      <div class="mb-4 flex items-center gap-2">
        <span class="h-2.5 w-2.5 rounded-full bg-[#FC6A97]"></span>
        <h3 class="text-sm font-bold uppercase tracking-wide text-[#33315A] dark:text-[#e8e4f8]">Capacity</h3>
      </div>
      <div class="space-y-2">
      <label for="maxCapacity" class="block text-sm font-semibold text-[#33315A] dark:text-[#e8e4f8]">Max Capacity</label>
      <input
        id="maxCapacity"
        name="maxCapacity"
        type="text"
        inputmode="numeric"
        value="<%= values.maxCapacity %>"
        placeholder="Leave blank for unlimited"
        class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-[#33315A] shadow-sm outline-none transition placeholder:text-slate-400 focus:border-[#3878E2] focus:ring-2 focus:ring-[#C897D8]/70 dark:border-[#C897D8]/25 dark:bg-[#2a2540] dark:text-[#e8e4f8] dark:placeholder:text-[#8a86aa]"
      />
      </div>
    </div>

    <div class="flex flex-col-reverse gap-3 border-t border-slate-200 pt-5 sm:flex-row sm:items-center sm:justify-end dark:border-[#C897D8]/20">
      <a
        href="/events"
        class="inline-flex justify-center rounded-lg border border-[#C897D8] px-5 py-3 text-sm font-semibold text-[#774C79] no-underline transition hover:bg-[#C897D8]/10 dark:text-[#C897D8] dark:hover:bg-[#C897D8]/10"
      >
        Cancel
      </a>
      <button
        type="submit"
        class="inline-flex justify-center rounded-lg bg-[#3878E2] px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-[#2f68c8] focus:outline-none focus:ring-2 focus:ring-[#C897D8] focus:ring-offset-2"
      >
        Create Event
      </button>
    </div>
  </form>
  </div>
</section>
