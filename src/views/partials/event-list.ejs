<%# src/views/partials/event-list.ejs %>

<% if (events.length === 0) { %>
  <div class="eb-card p-8 text-center">
    <p class="text-sm" style="color: var(--text-muted);">No events found matching your filters.</p>
    <a href="/events" class="mt-3 inline-block text-sm font-semibold hover:underline no-underline" style="color: var(--clr-blue);">
      Clear filters
    </a>
  </div>
<% } else { %>
  <div class="grid gap-4">
    <% events.forEach(function(event) { %>
      <article class="eb-card eb-card-tint p-5">
        <div class="flex items-start justify-between gap-4 flex-wrap">
          <div class="flex-1 min-w-0">

            <span class="inline-block mb-2 px-2.5 py-0.5 rounded-full text-xs font-semibold
              <%= event.category === 'academic' ? 'pill-academic' :
                  event.category === 'social'   ? 'pill-social'   :
                  event.category === 'sports'   ? 'pill-sports'   :
                  event.category === 'workshop' ? 'pill-workshop'  : 'pill-other' %>">
              <%= event.category.charAt(0).toUpperCase() + event.category.slice(1) %>
            </span>

            <h2 class="text-lg font-bold leading-snug mb-1" style="color: var(--text-primary);">
              <a href="/events/<%= event.id %>" class="no-underline hover:underline" style="color: var(--text-primary);">
                <%= event.title %>
              </a>
            </h2>

            <p class="text-sm mb-2 line-clamp-2" style="color: var(--text-muted);"><%= event.description %></p>

            <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs" style="color: var(--text-muted);">
              <span>📍 <%= event.location %></span>
              <span>
                📅 <%= new Date(event.startDateTime).toLocaleDateString("en-US", { weekday: "short", month: "short", day: "numeric" }) %>
                &nbsp;·&nbsp;
                <%= new Date(event.startDateTime).toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" }) %>
                –
                <%= new Date(event.endDateTime).toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" }) %>
              </span>
              <% if (event.maxCapacity !== null) { %>
                <span>👥 Capacity: <%= event.maxCapacity %></span>
              <% } %>
            </div>
          </div>

          <a href="/events/<%= event.id %>" class="shrink-0 eb-btn-primary text-sm no-underline">View</a>
        </div>
      </article>
    <% }); %>
  </div>
<% } %>