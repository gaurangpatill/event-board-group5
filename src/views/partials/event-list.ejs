<%# src/views/events/partials/event-list.ejs %>

<% if (events.length === 0) { %>
  <div class="p-8 text-center bg-white border border-slate-200 rounded-2xl shadow-sm">
    <p class="text-slate-500 text-sm">No events found matching your filters.</p>
    <a href="/events" class="mt-3 inline-block text-blue-600 text-sm hover:underline no-underline">
      Clear filters
    </a>
  </div>
<% } else { %>
  <div class="grid gap-4">
    <% events.forEach(function(event) { %>
      <article class="p-5 bg-white border border-slate-200 rounded-2xl shadow-sm hover:shadow-md transition-shadow">
        <div class="flex items-start justify-between gap-4 flex-wrap">
          <div class="flex-1 min-w-0">
            <span class="inline-block mb-2 px-2 py-0.5 rounded-full text-xs font-semibold
              <% if (event.category === 'academic')       { %>bg-blue-100 text-blue-700<%
                 } else if (event.category === 'social')  { %>bg-green-100 text-green-700<%
                 } else if (event.category === 'sports')  { %>bg-orange-100 text-orange-700<%
                 } else if (event.category === 'workshop'){ %>bg-purple-100 text-purple-700<%
                 } else                                   { %>bg-slate-100 text-slate-600<% } %>
            ">
              <%= event.category.charAt(0).toUpperCase() + event.category.slice(1) %>
            </span>

            <h2 class="text-lg font-bold text-slate-900 leading-snug mb-1">
              <a href="/events/<%= event.id %>" class="no-underline hover:underline text-slate-900">
                <%= event.title %>
              </a>
            </h2>

            <p class="text-sm text-slate-500 mb-2 line-clamp-2"><%= event.description %></p>

            <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-500">
              <span>📍 <%= event.location %></span>
              <span>
                📅 <%= new Date(event.startDateTime).toLocaleDateString("en-US", { weekday: "short", month: "short", day: "numeric" }) %>
                &nbsp;·&nbsp;
                <%= new Date(event.startDateTime).toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" }) %>
                –
                <%= new Date(event.endDateTime).toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" }) %>
              </span>
              <% if (event.maxCapacity !== null) { %>
                <span>👥 Capacity: <%= event.maxCapacity %></span>
              <% } %>
            </div>
          </div>

          <a href="/events/<%= event.id %>" class="shrink-0 px-4 py-2 rounded-lg bg-blue-600 text-white text-sm font-medium hover:bg-blue-700 no-underline">
            View
          </a>
        </div>
      </article>
    <% }); %>
  </div>
<% } %>
