<%# Partial: RSVP section for event detail page. Swapped in place via HTMX. %>
<%# Variables: eventId (string), currentRsvp (IRSVPRecord | null), eventStatus (string), waitlistPosition (number | null) %>

<%
  const headerPillClasses =
    currentRsvp && currentRsvp.status === "going"
      ? "bg-emerald-100 text-emerald-700 ring-1 ring-emerald-200"
      : currentRsvp && currentRsvp.status === "waitlisted"
        ? "bg-yellow-100 text-yellow-800 ring-1 ring-yellow-200"
        : currentRsvp && currentRsvp.status === "cancelled"
          ? "bg-red-100 text-red-700 ring-1 ring-red-200"
          : "bg-slate-100 text-slate-500 ring-1 ring-slate-200";
  const headerPillLabel =
    currentRsvp && currentRsvp.status === "going"
      ? "RSVP: Going"
      : currentRsvp && currentRsvp.status === "waitlisted"
        ? "RSVP: Waitlisted"
        : currentRsvp && currentRsvp.status === "cancelled"
          ? "RSVP: Cancelled"
          : "Not RSVPed";
%>

<span
  id="rsvp-status-pill"
  hx-swap-oob="outerHTML"
  class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold <%= headerPillClasses %>"
>
  <%= headerPillLabel %>
</span>

<div id="waitlist-position" hx-swap-oob="innerHTML">
  <%- include("waitlist-position", { position: waitlistPosition }) %>
</div>

<div
  id="rsvp-section"
  class="mt-6"
>
  <div
    class="hidden"
    hx-get="/events/<%= eventId %>"
    hx-select="#attendance-section"
    hx-target="#attendance-section"
    hx-swap="outerHTML"
    hx-trigger="load delay:200ms"
  ></div>
  <% if (eventStatus === "published") { %>
    <div class="flex items-center gap-3 flex-wrap">
    <% if (currentRsvp && currentRsvp.status !== "cancelled") { %>
      <%
        const buttonClasses =
          currentRsvp.status === "going"
            ? "bg-white border border-rose-300 text-rose-700 hover:bg-rose-50"
            : "bg-amber-50 border border-amber-300 text-amber-900 hover:bg-amber-100";
        const buttonLabel =
          currentRsvp.status === "going" ? "Cancel RSVP" : "Leave Waitlist";
      %>
      <button
        hx-post="/events/<%= eventId %>/rsvp"
        hx-target="#rsvp-section"
        hx-swap="outerHTML"
        class="px-5 py-2.5 rounded-lg font-semibold text-sm transition-all duration-200 cursor-pointer shadow-sm hover:shadow <%= buttonClasses %>"
      >
        <%= buttonLabel %>
      </button>
    <% } else { %>
      <button
        hx-post="/events/<%= eventId %>/rsvp"
        hx-target="#rsvp-section"
        hx-swap="outerHTML"
        class="px-5 py-2.5 rounded-lg bg-blue-600 text-white font-semibold text-sm cursor-pointer transition-all duration-200 hover:bg-blue-700 hover:shadow"
      >
        <%= currentRsvp && currentRsvp.status === "cancelled" ? "RSVP Again" : "RSVP" %>
      </button>
    <% } %>
    <% if (waitlistPosition !== null) { %>
      <span class="inline-flex items-center gap-1.5 sm:gap-2 px-3 py-2 sm:px-5 sm:py-2.5 rounded-lg bg-yellow-50 border border-yellow-300 text-xs sm:text-sm font-semibold text-yellow-800 whitespace-nowrap">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="sm:hidden">Waitlist #<%= waitlistPosition %></span>
        <span class="hidden sm:inline">Waitlist Position: #<%= waitlistPosition %></span>
      </span>
    <% } %>
    </div>
  <% } %>
</div>
