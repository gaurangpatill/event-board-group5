<%# Partial: RSVP section for event detail page. Swapped in place via HTMX. %>
<%# Variables: eventId (string), currentRsvp (IRSVPRecord | null), eventStatus (string) %>

<div id="rsvp-section" class="mt-6 flex items-center gap-4 flex-wrap">
  <% if (eventStatus === "published") { %>
    <% if (currentRsvp && currentRsvp.status !== "cancelled") { %>
      <%
        const statusColor =
          currentRsvp.status === "going"      ? "bg-green-100 text-green-700"  :
          currentRsvp.status === "waitlisted" ? "bg-yellow-100 text-yellow-700" :
                                                "bg-slate-100 text-slate-500";
        const label = currentRsvp.status.charAt(0).toUpperCase() + currentRsvp.status.slice(1);
      %>
      <span class="inline-block px-3 py-1 rounded-full text-sm font-semibold <%= statusColor %>">
        <%= label %>
      </span>
      <button
        hx-post="/events/<%= eventId %>/rsvp"
        hx-target="#rsvp-section"
        hx-swap="outerHTML"
        class="px-5 py-2.5 rounded-lg bg-white border border-red-200 text-red-600 font-medium text-sm hover:bg-red-50 cursor-pointer"
      >
        Cancel RSVP
      </button>
    <% } else { %>
      <% if (currentRsvp && currentRsvp.status === "cancelled") { %>
        <span class="inline-block px-3 py-1 rounded-full text-sm font-semibold bg-slate-100 text-slate-500">
          Cancelled
        </span>
      <% } %>
      <button
        hx-post="/events/<%= eventId %>/rsvp"
        hx-target="#rsvp-section"
        hx-swap="outerHTML"
        class="px-5 py-2.5 rounded-lg bg-blue-600 text-white font-medium text-sm hover:bg-blue-700 cursor-pointer"
      >
        RSVP
      </button>
    <% } %>
  <% } %>
</div>
