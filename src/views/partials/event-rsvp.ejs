<%# Partial: RSVP section for event detail page. Swapped in place via HTMX. %>
<%# Variables: eventId (string), currentRsvp (IRSVPRecord | null), eventStatus (string), waitlistPosition (number | null) %>

<%
  const headerPillClasses =
    currentRsvp && currentRsvp.status === "going"
      ? "status-going"
      : currentRsvp && currentRsvp.status === "waitlisted"
        ? "status-waitlisted"
        : currentRsvp && currentRsvp.status === "cancelled"
          ? "status-cancelled"
          : "status-cancelled";
  const headerPillLabel =
    currentRsvp && currentRsvp.status === "going"
      ? "RSVP: Going"
      : currentRsvp && currentRsvp.status === "waitlisted"
        ? "RSVP: Waitlisted"
        : currentRsvp && currentRsvp.status === "cancelled"
          ? "RSVP: Cancelled"
          : "Not RSVPed";
%>

<span
  id="rsvp-status-pill"
  hx-swap-oob="outerHTML"
  class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold <%= headerPillClasses %>"
  style="border: 1px solid var(--border-card);"
>
  <%= headerPillLabel %>
</span>

<div id="waitlist-position" hx-swap-oob="innerHTML">
  <%- include("waitlist-position", { position: waitlistPosition }) %>
</div>

<div
  id="rsvp-section"
  class="mt-6"
>
  <div
    class="hidden"
    hx-get="/events/<%= eventId %>"
    hx-select="#attendance-section"
    hx-target="#attendance-section"
    hx-swap="outerHTML"
    hx-trigger="load delay:200ms"
  ></div>
  <% if (eventStatus === "published") { %>
    <div class="flex items-center gap-3 flex-wrap">
    <% if (currentRsvp && currentRsvp.status !== "cancelled") { %>
      <%
        const buttonClasses =
          currentRsvp.status === "going"
            ? "eb-btn-danger"
            : "eb-btn-outline";
        const buttonLabel =
          currentRsvp.status === "going" ? "Cancel RSVP" : "Leave Waitlist";
      %>
      <button
        hx-post="/events/<%= eventId %>/rsvp"
        hx-target="#rsvp-section"
        hx-swap="outerHTML"
        class="px-5 py-2.5 rounded-lg font-semibold text-sm transition-all duration-200 cursor-pointer shadow-sm hover:shadow <%= buttonClasses %>"
        <% if (currentRsvp && currentRsvp.status === "waitlisted") { %>
          style="background: rgba(245, 158, 11, 0.18); border: 1.5px solid rgba(245, 158, 11, 0.42); color: #92400e;"
        <% } %>
      >
        <%= buttonLabel %>
      </button>
    <% } else { %>
      <button
        hx-post="/events/<%= eventId %>/rsvp"
        hx-target="#rsvp-section"
        hx-swap="outerHTML"
        class="px-5 py-2.5 rounded-lg eb-btn-primary"
      >
        <%= currentRsvp && currentRsvp.status === "cancelled" ? "RSVP Again" : "RSVP" %>
      </button>
    <% } %>
    <% if (waitlistPosition !== null) { %>
      <span class="inline-flex items-center gap-1.5 sm:gap-2 px-3 py-2 sm:px-5 sm:py-2.5 rounded-lg text-xs sm:text-sm font-semibold whitespace-nowrap"
        style="background: rgba(245, 158, 11, 0.14); border: 1px solid rgba(245, 158, 11, 0.42); color: #92400e;">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 sm:w-4 sm:h-4" style="color: #a16207;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="sm:hidden">Waitlist #<%= waitlistPosition %></span>
        <span class="hidden sm:inline">Waitlist Position: #<%= waitlistPosition %></span>
      </span>
    <% } %>
    </div>
  <% } %>
</div>
