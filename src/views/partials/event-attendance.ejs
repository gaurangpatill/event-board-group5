<h2 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-4">Attendance</h2>

<% if (maxCapacity !== null) { %>
  <div class="flex items-end justify-between mb-2">
    <span class="text-3xl font-bold text-slate-900"><%= attendeeCount %></span>
    <span class="text-slate-400 text-sm mb-1">of <%= maxCapacity %> attending</span>
  </div>
<% } else { %>
  <div class="flex items-center gap-2">
    <span class="text-3xl font-bold text-slate-900"><%= attendeeCount %></span>
    <span class="text-slate-400 text-sm">attending</span>
  </div>
  <p class="text-xs text-slate-500 mt-1">Unlimited capacity</p>
<% } %>
