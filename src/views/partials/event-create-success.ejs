<section
  id="event-create-form"
  class="overflow-hidden rounded-lg shadow-md"
  style="background: var(--bg-card); border: 1.5px solid var(--border-card); box-shadow: 0 2px 14px rgba(51,49,90,0.08);"
>
  <div class="h-1.5 bg-gradient-to-r from-[#3878E2] via-[#C897D8] to-[#FC6A97]"></div>
  <div class="p-5 sm:p-7">
  <div class="mb-5">
    <p class="mb-2 text-sm font-semibold uppercase tracking-wide" style="color: var(--text-secondary);">Draft Created</p>
    <h2 class="mb-2 text-2xl font-bold" style="color: var(--text-primary);">Event Created</h2>
    <p style="color: var(--text-muted);">
      <strong><%= event.title %></strong> has been created successfully.
    </p>
  </div>

  <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
    <a
      href="/events/<%= event.id %>"
      class="eb-btn-primary inline-flex justify-center px-5 py-3"
    >
      View Event
    </a>
    <a
      href="/events/<%= event.id %>/edit"
      class="eb-btn-outline inline-flex justify-center px-5 py-3"
    >
      Edit Event
    </a>
    <a
      href="/events/new"
      class="eb-btn-outline inline-flex justify-center px-5 py-3"
    >
      Create Another
    </a>
  </div>
  </div>
</section>
