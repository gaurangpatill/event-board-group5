<section id="event-create-form" class="p-6 bg-white border border-slate-200 rounded-2xl shadow-lg">
  <div class="mb-4">
    <h2 class="text-2xl font-bold text-slate-900 mb-2">Event Created</h2>
    <p class="text-slate-600">
      <strong><%= event.title %></strong> has been created successfully.
    </p>
  </div>

  <div class="flex items-center gap-3 flex-wrap">
    <a
      href="/events/<%= event.id %>"
      class="px-5 py-3 rounded-xl bg-blue-600 text-white font-medium no-underline hover:bg-blue-700"
    >
      View Event
    </a>
    <a
      href="/events/<%= event.id %>/edit"
      class="px-5 py-3 rounded-xl border border-slate-300 text-slate-700 no-underline hover:bg-slate-50"
    >
      Edit Event
    </a>
    <a
      href="/events/new"
      class="px-5 py-3 rounded-xl border border-slate-300 text-slate-700 no-underline hover:bg-slate-50"
    >
      Create Another
    </a>
  </div>
</section>
